<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Created Form</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-gradient-to-br from-indigo-400 via-purple-500 to-pink-500 min-h-screen flex items-center justify-center"
  >
    <div class="absolute top-4 left-4">
      <a
        href="/read"
        class="bg-indigo-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 transition duration-200"
      >
        Go to User Page
      </a>
    </div>
    <div class="bg-white shadow-2xl rounded-lg p-10 w-full max-w-lg">
      <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">
        Create User
      </h2>
      <form action="/create" method="post">
        <!-- Name Input -->
        <div class="mb-6">
          <label for="name" class="block text-gray-700 font-semibold mb-2"
            >Name</label
          >
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter your name"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent"
          />
        </div>
        <!-- Email Input -->
        <div class="mb-6">
          <label for="email" class="block text-gray-700 font-semibold mb-2"
            >Email</label
          >
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent"
          />
        </div>
        <!-- Image URL Input -->
        <div class="mb-6">
          <label for="image" class="block text-gray-700 font-semibold mb-2"
            >Image URL</label
          >
          <input
            type="text"
            id="image"
            name="image"
            placeholder="Enter image URL"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent"
          />
        </div>
        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-indigo-500 text-white font-semibold py-3 rounded-lg hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 transition duration-200"
        >
          Create User
        </button>
      </form>
    </div>
  </body>
</html>
